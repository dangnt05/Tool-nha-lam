{
  "manifest_version": 3,
  "name": "Đăng ký học VNU tool",
  "version": "1.1.0",
  "description": "Find and step through course rows quickly, with optional safe auto-selection.",
  "permissions": ["storage", "tabs", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Mở Đăng ký học VNU tool" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["page-styles.css"],
      "run_at": "document_idle"
    }
  ]
}
